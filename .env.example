# ==========================================
# Enterprise ETL Pipeline Environment Config
# ==========================================

# Environment: development, staging, production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Stripe API Configuration
STRIPE_API_KEY=sk_test_mock_stripe_key_example12345
STRIPE_BASE_URL=https://api.stripe.com/v1
STRIPE_PAGE_LIMIT=100
STRIPE_RATE_LIMIT_RPS=25

# Salesforce API Configuration
SALESFORCE_ACCESS_TOKEN=mock_salesforce_access_token_example12345
SALESFORCE_INSTANCE_URL=https://your-org.my.salesforce.com
SALESFORCE_API_VERSION=v59.0
SALESFORCE_PAGE_LIMIT=2000
SALESFORCE_RATE_LIMIT_RPS=15

# AWS / S3 Staging Configuration
# Storage mode: 's3' (real AWS) or 'local' (local staging directory)
STORAGE_MODE=local
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=enterprise-etl-data-lake
S3_ENDPOINT_URL=
LOCAL_STORAGE_PATH=./data_lake_staging

# Pipeline Execution Settings
EXTRACTION_BATCH_SIZE=500
MAX_RETRIES=5
RETRY_INITIAL_BACKOFF=1.0
RETRY_MAX_BACKOFF=60.0
