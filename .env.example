# ==========================================
# Enterprise ETL Pipeline Environment Config
# ==========================================

# Environment: development, staging, production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Stripe API Configuration
STRIPE_API_KEY=sk_test_mock_stripe_key_example12345
STRIPE_BASE_URL=https://api.stripe.com/v1
STRIPE_PAGE_LIMIT=100
STRIPE_RATE_LIMIT_RPS=25

# Salesforce API Configuration
SALESFORCE_ACCESS_TOKEN=mock_salesforce_access_token_example12345
SALESFORCE_INSTANCE_URL=https://your-org.my.salesforce.com
SALESFORCE_API_VERSION=v59.0
SALESFORCE_PAGE_LIMIT=2000
SALESFORCE_RATE_LIMIT_RPS=15

# AWS / S3 Staging Configuration
# Storage mode: 's3' (real AWS) or 'local' (local staging directory)
STORAGE_MODE=local
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=enterprise-etl-data-lake
S3_ENDPOINT_URL=
LOCAL_STORAGE_PATH=./data_lake_staging

# Pipeline Execution Settings
EXTRACTION_BATCH_SIZE=500
MAX_RETRIES=5
RETRY_INITIAL_BACKOFF=1.0
RETRY_MAX_BACKOFF=60.0

# ==========================================
# Week 3: Target Data Warehouse (PostgreSQL / Snowflake / SQLite)
# ==========================================
DB_TYPE=sqlite
DB_SQLITE_DB_PATH=./data_lake_staging/warehouse.db
# For PostgreSQL / Snowflake:
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=enterprise_dw
# DB_SCHEMA=public
# Or direct connection string:
# DB_CONNECTION_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/enterprise_dw

# ==========================================
# Week 4: Alerting & Notifications (Slack / Email)
# ==========================================
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
ALERT_SLACK_CHANNEL=#data-engineering-alerts

ALERT_EMAIL_ENABLED=false
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=etl-alerts@example.com
ALERT_SMTP_PASSWORD=app_specific_password_here
ALERT_EMAIL_FROM=etl-alerts@example.com
ALERT_EMAIL_TO=data-team@example.com
ALERT_ON_SUCCESS=true
ALERT_ON_FAILURE=true

# ==========================================
# Week 4: Apache Airflow Scheduling
# ==========================================
AIRFLOW_DAG_SCHEDULE_DAILY=0 2 * * *
AIRFLOW_DAG_SCHEDULE_HOURLY=0 * * * *
AIRFLOW_RETRIES=2
AIRFLOW_RETRY_DELAY_SECONDS=300
AIRFLOW_SLA_MINUTES=60
